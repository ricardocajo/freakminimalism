# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Stripe secret key. Prefer a RESTRICTED key (rk_live_… / rk_test_…) over the
# full sk_ key. Scopes needed by this repo:
#   Products            write   (scripts/seed-stripe.mjs)
#   Prices              write   (scripts/seed-stripe.mjs)
#   Checkout Sessions   write   (src/app/api/stripe/checkout_sessions/route.ts)
#   Coupons             read    (promo code lookup)
#   Promotion codes     read    (promo code lookup)
# Note: src/data/products.ts holds LIVEMODE price IDs, so catalogue seeding
# needs a live-mode key. Use a test-mode key for checkout experiments only.
STRIPE_SECRET_KEY=

# Base URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
